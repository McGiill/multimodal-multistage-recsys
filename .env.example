# 로컬 실행용: cp .env.example .env (docker compose는 없어도 동작한다)
# 포트가 겹치면 docker compose용 값을 바꾼다: API_HOST_PORT=8000, DASHBOARD_HOST_PORT=8501, REDIS_HOST_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
DATA_DIR=./data
ARTIFACT_DIR=./artifacts
MODEL_VERSION=latest
DEVICE=cpu
